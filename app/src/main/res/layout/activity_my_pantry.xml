<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnPantryHome"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_home_back"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="center"
                android:padding="11dp"
                android:contentDescription="Back to home dashboard"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="My Pantry"
                    android:textColor="#24452E"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your kitchen inventory"
                    android:textColor="#788078"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Introduction -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Keep track of ingredients and reduce food waste."
            android:textColor="#626B62"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

        <!-- Search field -->
        <EditText
            android:id="@+id/edtPantrySearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Search your ingredients"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#24352A"
            android:textColorHint="#788078"
            android:textSize="15sp"
            android:importantForAutofill="no" />

        <!-- Section heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your ingredients"
                android:textColor="#24452E"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap a card to edit"
                android:textColor="#788078"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Empty pantry message -->
        <TextView
            android:id="@+id/txtMyPantryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="28dp"
            android:text="Your pantry is empty.\n\nTap + to add your first ingredient."
            android:textColor="#626B62"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

        <!-- Ingredient list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMyPantry"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="92dp"
            android:scrollbars="vertical" />

    </LinearLayout>

    <!-- Floating add ingredient button -->
    <TextView
        android:id="@+id/fabAddIngredient"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_fab_add"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:elevation="8dp"
        android:contentDescription="Add ingredient"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>

